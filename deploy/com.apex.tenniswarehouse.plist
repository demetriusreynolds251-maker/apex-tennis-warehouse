<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apex.tenniswarehouse</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/path/to/home/openclaw/tennis_warehouse_collector.py</string>
        <string>--forward</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/home/openclaw</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/home/openclaw/data/logs/tennis_warehouse_collector.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/home/openclaw/data/logs/tennis_warehouse_collector_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
